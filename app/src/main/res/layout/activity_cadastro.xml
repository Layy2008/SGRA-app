<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo / Ícone Escola -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/logoescola" /> <!-- Substitua pelo nome do seu arquivo de imagem em drawable -->

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicitar Cadastro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0B3C5D"
            android:layout_marginBottom="4dp"/>

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preencha seus dados para criar sua conta."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Card Branco do Formulário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_branco"
            android:padding="20dp"
            android:elevation="2dp">

            <!-- Campo Nome Completo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome Completo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editNome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Digite seu nome completo"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo Matrícula -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matrícula"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editMatricula"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Digite sua matrícula"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo CPF -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editCpf"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="000.000.000-00"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo E-mail -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="NomeSobrenome@aluno.winehouse.edu.br"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo Senha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Crie uma senha"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo Confirmar Senha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar Senha"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editConfirmarSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Digite novamente sua senha"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Caixa de aviso sobre o e-mail -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ao clicar em &quot;Criar conta&quot;, enviaremos um e-mail de ativação para a sua caixa de entrada."
                android:textSize="12sp"
                android:textColor="#4A5568"
                android:background="#F0F4FF"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <!-- Botão Criar Conta -->
            <Button
                android:id="@+id/btnCriarConta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Criar Conta"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#0B4F9C"
                android:layout_marginBottom="16dp"/>

            <!-- Link Voltar para o Login -->
            <TextView
                android:id="@+id/textVoltarLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Voltar para o Login"
                android:textColor="#0B4F9C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>